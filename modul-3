import 'package:flutter/material.dart';

void main() {
  runApp(const BangunRuangApp());
}

class BangunRuangApp extends StatelessWidget {
  const BangunRuangApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Bangun Ruang',
      theme: ThemeData(
        primaryColor: Colors.lightBlue,
        scaffoldBackgroundColor: Colors.white,
      ),
      home: const HomePage(),
    );
  }
}

class HomePage extends StatelessWidget {
  const HomePage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: Colors.lightBlue,
        title: const Text('Pembelajaran Bangun Ruang'),
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: const [
          HeaderCard(),
          SizedBox(height: 16),
          BangunRuangTile(
            icon: Icons.crop_square,
            title: 'Kubus',
            subtitle: 'Rumus volume & luas permukaan',
          ),
          BangunRuangTile(
            icon: Icons.view_in_ar,
            title: 'Balok',
            subtitle: 'Perhitungan bangun balok',
          ),
          BangunRuangTile(
            icon: Icons.circle_outlined,
            title: 'Tabung',
            subtitle: 'Bangun ruang sisi lengkung',
          ),
          BangunRuangTile(
            icon: Icons.change_history,
            title: 'Kerucut',
            subtitle: 'Volume dan selimut kerucut',
          ),
        ],
      ),
    );
  }
}

class HeaderCard extends StatelessWidget {
  const HeaderCard({super.key});

  @override
  Widget build(BuildContext context) {
    return Card(
      color: Colors.lightBlue.shade50,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: const [
            Text('Selamat Datang', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
            SizedBox(height: 8),
            Text('Pilih bangun ruang untuk melihat rumus dan contoh soal'),
          ],
        ),
      ),
    );
  }
}

class BangunRuangTile extends StatelessWidget {
  final IconData icon;
  final String title;
  final String subtitle;

  const BangunRuangTile({
    super.key,
    required this.icon,
    required this.title,
    required this.subtitle,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: ListTile(
        leading: Icon(icon, size: 36, color: Colors.lightBlue),
        title: Text(title, style: const TextStyle(fontWeight: FontWeight.bold)),
        subtitle: Text(subtitle),
        trailing: const Icon(Icons.arrow_forward_ios, size: 16),
        onTap: () {},
      ),
    );
  }
}
